# Copier ce fichier en .env.local et adapter les valeurs.

# Adresse publique du site (obligatoire)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL de l'API, côté serveur uniquement (optionnelle tant que l'API n'existe pas)
# API_URL=
# Dossier des données simulées (optionnel, défaut : ./data)
# CONTINENG_DATA_DIR=

# Fuseau de l'aperçu WhatsApp, calculé côté serveur (optionnel, défaut : Africa/Douala)
# FUSEAU_APERCU=Africa/Douala
